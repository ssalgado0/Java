    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.57.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "baseline-browser-mapping": "^2.9.12",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
