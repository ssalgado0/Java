    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build-test": "ng build --configuration development",
    "build-e2e": "ng build --configuration e2e",
    "build-prod": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --watch=false --progress=false --browsers=ChromeHeadlessCI --code-coverage --source-map=false",
